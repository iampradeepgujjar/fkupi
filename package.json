{
  "name": "baby-winter-clothes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "react": "latest",
    "react-dom": "latest",
